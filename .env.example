# Server-side only (BFF / Vercel API functions)
AUTH_ISSUER=https://api.devtest.catalystone.dev/auth2
CLIENT_ID=<your-client-id>
CLIENT_SECRET=<your-client-secret>
REDIRECT_URI=https://<your-vercel-domain>/oauth/callback
SCOPES=profile
SESSION_ENCRYPTION_SECRET=<random-32+-char-string>

# Optional: Upstash Redis for shared session storage
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...

# Optional: API base URL for the Catalystone API proxy
# API_BASE=https://api.devtest.catalystone.dev
